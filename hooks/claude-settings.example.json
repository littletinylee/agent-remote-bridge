{
  "_comment": "Example ~/.claude/settings.json hooks section for agent-remote-bridge. Merge into your existing settings; do not replace the file. Requires `arb` on PATH or use the full path: python -m arb hook claude-code",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python -m arb hook claude-code", "timeout": 20 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python -m arb hook claude-code", "timeout": 20 }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "python -m arb hook claude-code", "timeout": 20 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python -m arb hook claude-code", "timeout": 30 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "python -m arb hook claude-code", "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "python -m arb hook claude-code", "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "_comment": "Only active when approval_mode=approve in the bridge config. timeout must cover approval_timeout_s.",
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python -m arb hook claude-code", "timeout": 900 }
        ]
      }
    ]
  }
}
